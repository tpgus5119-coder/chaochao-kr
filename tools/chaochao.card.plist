<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 매일 저녁 카드뉴스 (대표님 지시 2026-09-01)
     저녁 8시에 깃허브 로봇이 그날 기사를 받아 온다. 20분 뒤 이 맥이 카드로 만든다.
     그림(Draw Things)과 소리는 이 맥에만 있어서 깃허브에서는 못 만든다. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>chaochao.card</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/leesehyeon/베트남어-어플/tools/card_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>20</integer></dict>
  <key>StandardOutPath</key><string>/Users/leesehyeon/베트남어-어플/logs/card_daily.log</string>
  <key>StandardErrorPath</key><string>/Users/leesehyeon/베트남어-어플/logs/card_daily.log</string>
</dict>
</plist>
